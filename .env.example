# SMTP Configuration for Contact Form
# Copy this file to .env.local for local development
# Add these as Environment Variables in Vercel dashboard for production

SMTP_HOST=paxxmo.com
SMTP_PORT=465
SMTP_USER=hello@paxxmo.com
SMTP_PASS=
SMTP_FROM=hello@paxxmo.com
SMTP_TO=hello@paxxmo.com

# Tawk.to Live Chat (FREE)
# 1. Sign up at https://www.tawk.to
# 2. Get your IDs from: Administration → Channels → Chat Widget
# 3. Look for: https://embed.tawk.to/PROPERTY_ID/WIDGET_ID
VITE_TAWK_PROPERTY_ID=https://embed.tawk.to/69aed479121cf01c355b92bf/1jj9ervju
VITE_TAWK_WIDGET_ID=default

# Blog System 2.0: configure your reachable Supabase project
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable both in production after the database is reachable and migrated.
SEO_REQUIRE_LIVE_BLOG=1
VITE_REQUIRE_LIVE_BLOG=1
# Vercel historic-slug handler uses server-side public credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
