# Serve generated public pages and preserve administration deep links.
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.paxxmo\.com$ [NC]
  RewriteRule ^ https://paxxmo.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^paxxmo\.com$ [NC]
  RewriteRule ^ https://paxxmo.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
  RewriteRule ^px-manage(?:/.*)?$ admin.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
<IfModule mod_headers.c>
  <Files "admin.html">
    Header set X-Robots-Tag "noindex, follow"
  </Files>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
